@{
    ViewData["Title"] = "Đã Xảy Ra Lỗi";
    var errorMsg = ViewBag.ErrorMessage as string;
    var stackTrace = ViewBag.StackTrace as string;
}

<div class="container py-5 text-center">
    <div class="card shadow border-0 p-5 mx-auto" style="max-width: 700px; border-radius: 16px;">
        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
        <h3 class="fw-bold mt-3 text-danger">Đã xảy ra lỗi trong quá trình xử lý!</h3>
        
        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="alert alert-danger text-start mt-3 small">
                <strong>Chi tiết lỗi:</strong>
                <pre class="mb-0 mt-1" style="white-space: pre-wrap; font-family: monospace;">@errorMsg</pre>
            </div>
            @if (!string.IsNullOrEmpty(stackTrace))
            {
                <details class="text-start mt-2">
                    <summary class="small text-muted" style="cursor: pointer;">Xem chi tiết Stack Trace</summary>
                    <pre class="bg-light p-2 rounded small mt-1" style="max-height: 200px; overflow-y: auto; font-size: 0.75rem;">@stackTrace</pre>
                </details>
            }
        }
        else
        {
            <p class="text-muted">Vui lòng kiểm tra lại kết nối Cơ sở dữ liệu SQL Server hoặc thao tác vừa thực hiện.</p>
        }

        <div class="mt-4 d-flex justify-content-center gap-3">
            <a href="javascript:history.back()" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left me-1"></i>Quay Lại</a>
            <a href="/" class="btn btn-primary px-4"><i class="bi bi-house me-1"></i>Về Trang Chủ</a>
        </div>
    </div>
</div>
