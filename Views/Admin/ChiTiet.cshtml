@model DiemRenLuyen.Models.PhieuDanhGia
@using System.Globalization
@{
    ViewData["Title"] = "Chi Tiết & Chấm Điểm Rèn Luyện";
    var daChot      = Model?.DaChot ?? false;
    var daChamKhoa  = Model?.DiemAdminCham != null;
    var m1 = Model?.Muc1 ?? new DiemRenLuyen.Models.ChiTietMuc1();
    var m2 = Model?.Muc2 ?? new DiemRenLuyen.Models.ChiTietMuc2();
    var m3 = Model?.Muc3 ?? new DiemRenLuyen.Models.ChiTietMuc3();
    var m4 = Model?.Muc4 ?? new DiemRenLuyen.Models.ChiTietMuc4();
    var m5 = Model?.Muc5 ?? new DiemRenLuyen.Models.ChiTietMuc5();

    string Fmt(decimal? val) => (val ?? 0m).ToString("0.##", CultureInfo.InvariantCulture);
    string FmtKhoa(decimal? adminVal, decimal? svVal)
        => (daChamKhoa ? (adminVal ?? 0m) : (svVal ?? 0m)).ToString("0.##", CultureInfo.InvariantCulture);
}

<style>
    .phieu-card { border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
    .table-eval th { background: #f8fafc; font-size: 0.85rem; font-weight: 600; vertical-align: middle; }
    .table-eval td { vertical-align: middle; font-size: 0.875rem; }
    .header-section { background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); color: white; border-radius: 12px; padding: 1.5rem; }
    .score-input { width: 78px; text-align: center; font-weight: 700; border-radius: 6px; border: 1.5px solid #3b82f6; color: #1d4ed8; }
    .score-input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(59,130,246,0.25); }
    .score-input:disabled { background-color: #f1f5f9; border-color: #cbd5e1; color: #64748b; cursor: not-allowed; }
    .section-title { background: #f1f5f9; border-left: 4px solid #2563eb; padding: 10px 14px; font-weight: 700; font-size: 0.95rem; margin-bottom: 0; }
    .sticky-summary { position: sticky; top: 80px; }
    #docPreviewContent { max-height: 72vh; overflow-y: auto; background: #fff; padding: 24px; border: 1px solid #e2e8f0; border-radius: 8px; line-height: 1.6; }
    #docPreviewContent img { max-width: 100%; height: auto; border-radius: 6px; margin: 10px 0; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    #docPreviewContent table { width: 100%; border-collapse: collapse; margin: 12px 0; }
    #docPreviewContent table td, #docPreviewContent table th { border: 1px solid #cbd5e1; padding: 6px 10px; }
</style>

<!-- HEADER THÔNG TIN SINH VIÊN -->
<div class="header-section mb-4 shadow">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div>
            <a href="/Admin/Index?hocKy=@Model?.HocKy" class="btn btn-sm btn-outline-light me-2">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
            <span class="badge bg-info text-dark fs-6">Duyệt & Chấm Điểm (Khoa / Hội đồng)</span>
        </div>
        <div>
            @if (daChot)
            {
                <span class="badge bg-success px-3 py-2 fs-6">
                    <i class="bi bi-lock-fill me-1"></i>Đã chốt On-chain
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                    <i class="bi bi-clock-history me-1"></i>Chưa chốt On-chain
                </span>
            }
        </div>
    </div>

    <h4 class="fw-bold mb-1">SV: @(Model?.TaiKhoan?.HoTen) - @(Model?.MSSV)</h4>
    <div class="small opacity-90">
        <span class="me-3"><strong>Lớp:</strong> @(Model?.TaiKhoan?.Lop)</span>
        @if (!string.IsNullOrEmpty(Model?.TaiKhoan?.KhoaHoc))
        {
            <span class="me-3"><strong>Khóa:</strong> @Model.TaiKhoan.KhoaHoc</span>
        }
        <span class="me-3"><strong>Học kỳ:</strong> @Model?.HocKy</span>
        @if (!string.IsNullOrEmpty(Model?.TaiKhoan?.DiaChiVi))
        {
            <span><strong>Ví SV:</strong> <code class="text-warning">@Model.TaiKhoan.DiaChiVi</code></span>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        @if (!string.IsNullOrEmpty(Model?.NoiDungKhieuNai))
        {
            <div class="alert @(Model.TrangThaiKhieuNai == "ChoXuLy" ? "alert-danger" : "alert-secondary") shadow-sm mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <strong>
                        <i class="bi bi-chat-left-quote-fill me-1"></i>
                        @(Model.TrangThaiKhieuNai == "ChoXuLy" ? "SINH VIÊN ĐANG KHIẾU NẠI / PHẢN HỒI:" : "LỊCH SỬ KHIẾU NẠI CỦA SINH VIÊN (ĐÃ XỬ LÝ):")
                    </strong>
                    <small class="text-muted">@Model.NgayKhieuNai?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                </div>
                <div class="p-2 bg-white rounded border text-dark">@Model.NoiDungKhieuNai</div>
            </div>
        }

        @if (!daChot)
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center py-2 px-3 mb-3 shadow-sm">
                <span class="small"><i class="bi bi-lightbulb-fill text-warning me-1"></i>@(daChamKhoa ? "Đang hiển thị điểm Khoa đã lưu. Bạn có thể chỉnh sửa và bấm Lưu lại." : "Đã điền sẵn theo điểm SV tự chấm để Khoa duyệt nhanh.")</span>
                <button type="button" class="btn btn-sm btn-primary text-nowrap ms-2" onclick="copyDiemSVSangKhoa()">
                    <i class="bi bi-copy me-1"></i>Reset theo điểm SV
                </button>
            </div>
        }

        <form method="post" action="/Admin/ChamDiem" id="adminEvalForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="phieuId" value="@Model?.Id" />

            <!-- MỤC I -->
            <div class="card phieu-card mb-4 overflow-hidden">
                <div class="section-title d-flex justify-content-between align-items-center">
                    <span>I. Đánh giá về ý thức tham gia học tập (Tối đa 20 điểm)</span>
                    <div>
                        <span class="badge bg-success me-1">SV: @m1.TongMuc1SV / 20</span>
                        <span class="badge bg-primary" id="badgeM1">Khoa: @(m1.TongMuc1Admin ?? 0) / 20</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-bordered table-eval mb-0">
                        <thead>
                            <tr class="text-center">
                                <th style="width: 45px;">#</th>
                                <th>Nội dung đánh giá</th>
                                <th style="width: 95px;">Tối đa</th>
                                <th style="width: 95px;">SV tự chấm</th>
                                <th style="width: 115px;">Khoa đánh giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center">1</td>
                                <td>Sinh viên có điểm trung bình học tập tích lũy với thang điểm 4</td>
                                <td class="text-center text-muted">5 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC1_DiemTBHT)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC1_DiemTBHT" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC1_DiemTBHT, m1.TC1_DiemTBHT)" min="0" max="5" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">2</td>
                                <td>Có giấy chứng nhận tham gia học các lớp chuyên đề kỹ năng học tập trong và ngoài Trường</td>
                                <td class="text-center text-muted">3 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC2_ChuyenDeKyNang)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC2_ChuyenDeKyNang" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC2_ChuyenDeKyNang, m1.TC2_ChuyenDeKyNang)" min="0" max="3" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">3</td>
                                <td>Hội thảo hoặc Tọa đàm do Khoa hoặc Trường tổ chức</td>
                                <td class="text-center text-muted">3 đ/lần</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC3_HoiThaoToaDam)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC3_HoiThaoToaDam" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC3_HoiThaoToaDam, m1.TC3_HoiThaoToaDam)" min="0" max="15" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">4</td>
                                <td>Các cuộc thi học thuật cấp Khoa hoặc Trường tổ chức trực tiếp hoặc trực tuyến</td>
                                <td class="text-center text-muted">7 đ/lần</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC4_ThiHocThuatTruong)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC4_ThiHocThuatTruong" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC4_ThiHocThuatTruong, m1.TC4_ThiHocThuatTruong)" min="0" max="14" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">5</td>
                                <td>Các cuộc thi học thuật do các đơn vị bên ngoài trường tổ chức</td>
                                <td class="text-center text-muted">8 đ/lần</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC5_ThiHocThuatNgoai)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC5_ThiHocThuatNgoai" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC5_ThiHocThuatNgoai, m1.TC5_ThiHocThuatNgoai)" min="0" max="16" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">6</td>
                                <td>Báo cáo khoa học cấp Khoa</td>
                                <td class="text-center text-muted">8 đ/lần</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC6_BaoCaoKhoaHocKhoa)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC6_BaoCaoKhoaHocKhoa" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC6_BaoCaoKhoaHocKhoa, m1.TC6_BaoCaoKhoaHocKhoa)" min="0" max="16" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">7</td>
                                <td>Tham gia đề tài NCKH Trường (không tính bài tập, tiểu luận, đồ án môn học, luận văn…)</td>
                                <td class="text-center text-muted">10 đ/lần</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC7_DeTaiNCKHTruong)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC7_DeTaiNCKHTruong" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC7_DeTaiNCKHTruong, m1.TC7_DeTaiNCKHTruong)" min="0" max="20" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">8</td>
                                <td>Viết bài báo khoa học trong và ngoài Trường</td>
                                <td class="text-center text-muted">8 đ/lần</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC8_BaiBaoKhoaHoc)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC8_BaiBaoKhoaHoc" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC8_BaiBaoKhoaHoc, m1.TC8_BaiBaoKhoaHoc)" min="0" max="16" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">9</td>
                                <td>Các cuộc thi khởi nghiệp do Trường tổ chức</td>
                                <td class="text-center text-muted">7 đ/lần</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC9_KhoiNghiepTruong)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC9_KhoiNghiepTruong" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC9_KhoiNghiepTruong, m1.TC9_KhoiNghiepTruong)" min="0" max="14" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">10</td>
                                <td>Các cuộc thi khởi nghiệp do đơn vị ngoài Trường tổ chức</td>
                                <td class="text-center text-muted">8 đ/lần</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC10_KhoiNghiepNgoai)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC10_KhoiNghiepNgoai" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC10_KhoiNghiepNgoai, m1.TC10_KhoiNghiepNgoai)" min="0" max="16" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">11</td>
                                <td>Thành viên các câu lạc bộ học thuật cấp Khoa, Trường</td>
                                <td class="text-center text-muted">2 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC11_ThanhVienCLB)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC11_ThanhVienCLB" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC11_ThanhVienCLB, m1.TC11_ThanhVienCLB)" min="0" max="2" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">12</td>
                                <td>Các hoạt động khác</td>
                                <td class="text-center text-muted">3 đ/lần</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m1.TC12_HoatDongKhac)</td>
                                <td class="text-center"><input type="number" name="muc1.Admin_TC12_HoatDongKhac" class="form-control score-input score-m1" value="@FmtKhoa(m1.Admin_TC12_HoatDongKhac, m1.TC12_HoatDongKhac)" min="0" max="15" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MỤC II -->
            <div class="card phieu-card mb-4 overflow-hidden">
                <div class="section-title d-flex justify-content-between align-items-center">
                    <span>II. Ý thức chấp hành nội quy, quy chế Nhà trường (Tối đa 25 điểm)</span>
                    <div>
                        <span class="badge bg-success me-1">SV: @m2.TongMuc2SV / 25</span>
                        <span class="badge bg-primary" id="badgeM2">Khoa: @(m2.TongMuc2Admin ?? 0) / 25</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-bordered table-eval mb-0">
                        <thead>
                            <tr class="text-center">
                                <th style="width: 45px;">#</th>
                                <th>Nội dung đánh giá</th>
                                <th style="width: 95px;">Tối đa</th>
                                <th style="width: 95px;">SV tự chấm</th>
                                <th style="width: 115px;">Khoa đánh giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center">1</td>
                                <td>Sinh viên có ý thức, thái độ trong học tập</td>
                                <td class="text-center text-muted">5 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m2.TC1_ThaiDoHocTap)</td>
                                <td class="text-center"><input type="number" name="muc2.Admin_TC1_ThaiDoHocTap" class="form-control score-input score-m2" value="@FmtKhoa(m2.Admin_TC1_ThaiDoHocTap, m2.TC1_ThaiDoHocTap)" min="0" max="5" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">2</td>
                                <td>Sinh viên có ý thức chấp hành tốt, đầy đủ các nội quy, quy chế của Nhà trường</td>
                                <td class="text-center text-muted">5 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m2.TC2_ChapHanhNoiQuy)</td>
                                <td class="text-center"><input type="number" name="muc2.Admin_TC2_ChapHanhNoiQuy" class="form-control score-input score-m2" value="@FmtKhoa(m2.Admin_TC2_ChapHanhNoiQuy, m2.TC2_ChapHanhNoiQuy)" min="0" max="5" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">3</td>
                                <td>Sinh viên thực hiện tốt quy chế khi tham gia các kỳ thi, cuộc thi</td>
                                <td class="text-center text-muted">5 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m2.TC3_QuyCheThi)</td>
                                <td class="text-center"><input type="number" name="muc2.Admin_TC3_QuyCheThi" class="form-control score-input score-m2" value="@FmtKhoa(m2.Admin_TC3_QuyCheThi, m2.TC3_QuyCheThi)" min="0" max="5" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">4</td>
                                <td>Chấp hành quy định của thư viện</td>
                                <td class="text-center text-muted">5 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m2.TC4_QuyDinhThuVien)</td>
                                <td class="text-center"><input type="number" name="muc2.Admin_TC4_QuyDinhThuVien" class="form-control score-input score-m2" value="@FmtKhoa(m2.Admin_TC4_QuyDinhThuVien, m2.TC4_QuyDinhThuVien)" min="0" max="5" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">5</td>
                                <td>Chấp hành quy định của phòng học, phòng máy, phòng thực hành</td>
                                <td class="text-center text-muted">5 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m2.TC5_QuyDinhPhongHocMay)</td>
                                <td class="text-center"><input type="number" name="muc2.Admin_TC5_QuyDinhPhongHocMay" class="form-control score-input score-m2" value="@FmtKhoa(m2.Admin_TC5_QuyDinhPhongHocMay, m2.TC5_QuyDinhPhongHocMay)" min="0" max="5" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">6</td>
                                <td>Thực hiện đăng ký ngoại trú</td>
                                <td class="text-center text-muted">5 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m2.TC6_DangKyNgoaiTru)</td>
                                <td class="text-center"><input type="number" name="muc2.Admin_TC6_DangKyNgoaiTru" class="form-control score-input score-m2" value="@FmtKhoa(m2.Admin_TC6_DangKyNgoaiTru, m2.TC6_DangKyNgoaiTru)" min="0" max="5" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">7</td>
                                <td>Mặc đồng phục đúng quy định</td>
                                <td class="text-center text-muted">5 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m2.TC7_MacDongPhuc)</td>
                                <td class="text-center"><input type="number" name="muc2.Admin_TC7_MacDongPhuc" class="form-control score-input score-m2" value="@FmtKhoa(m2.Admin_TC7_MacDongPhuc, m2.TC7_MacDongPhuc)" min="0" max="5" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                            <tr>
                                <td class="text-center">8</td>
                                <td>Sinh hoạt lớp với CVHT</td>
                                <td class="text-center text-muted">5 đ/HK</td>
                                <td class="text-center fw-bold text-success sv-val">@Fmt(m2.TC8_SinhHoatLopCVHT)</td>
                                <td class="text-center"><input type="number" name="muc2.Admin_TC8_SinhHoatLopCVHT" class="form-control score-input score-m2" value="@FmtKhoa(m2.Admin_TC8_SinhHoatLopCVHT, m2.TC8_SinhHoatLopCVHT)" min="0" max="5" step="0.5" @(daChot?"disabled":"") /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MỤC III -->
            <div class="card phieu-card mb-4 overflow-hidden">
                <div class="section-title d-flex justify-content-between align-items-center">
