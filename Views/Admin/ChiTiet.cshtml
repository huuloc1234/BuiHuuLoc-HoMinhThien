            <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px;">
                <div class="card-header bg-white fw-bold border-bottom">
                    <i class="bi bi-file-earmark-word-fill text-primary me-2"></i>Minh Chứng File Word
                </div>
                <div class="card-body">
                    @if (Model?.TrangThaiFile == "Đã nộp" && !string.IsNullOrEmpty(Model?.DuongDanFileWord))
                    {
                        <div class="p-2 bg-info bg-opacity-10 border border-info rounded mb-3 small">
                            <div class="text-muted">File của sinh viên:</div>
