<!-- MODAL ĐỌC FILE WORD TRỰC TIẾP TRÊN TRÌNH DUYỆT -->
<div class="modal fade" id="docPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-file-earmark-word me-2"></i>Xem Minh Chứng: <span id="previewFileName"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div id="docPreviewLoading" class="text-center py-5">
                    <div class="spinner-border text-primary mb-2"></div>
                    <div class="text-muted">Đang đọc nội dung file Word từ server...</div>
                </div>
                <div id="docPreviewError" class="alert alert-danger d-none"></div>
                <div id="docPreviewContent" class="d-none"></div>
            </div>
            <div class="modal-footer">
                <a id="btnModalDownload" href="#" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-download me-1"></i>Tải file này về máy
                </a>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>

<script>
    function calculateAdminTotal() {
        let m1 = 0;
        document.querySelectorAll('.score-m1').forEach(i => m1 += (parseFloat(i.value) || 0));
        m1 = Math.min(20, Math.max(0, m1));

        let m2 = 0;
        document.querySelectorAll('.score-m2').forEach(i => {
            let v = Math.min(5, Math.max(0, parseFloat(i.value) || 0));
            m2 += v;
        });
        m2 = Math.min(25, Math.max(0, m2));

        let m3 = 0;
        document.querySelectorAll('.score-m3').forEach(i => m3 += Math.max(0, parseFloat(i.value) || 0));
        m3 = Math.min(20, Math.max(0, m3));

        let m4 = 0;
        document.querySelectorAll('.score-m4').forEach(i => m4 += Math.max(0, parseFloat(i.value) || 0));
        m4 = Math.min(25, Math.max(0, m4));

        let m5 = 0;
        document.querySelectorAll('.score-m5').forEach(i => m5 += Math.max(0, parseFloat(i.value) || 0));
        m5 = Math.min(10, Math.max(0, m5));

        let total = m1 + m2 + m3 + m4 + m5;

        document.getElementById('badgeM1').textContent = 'Khoa: ' + m1.toFixed(1) + ' / 20';
        document.getElementById('badgeM2').textContent = 'Khoa: ' + m2.toFixed(1) + ' / 25';
        document.getElementById('badgeM3').textContent = 'Khoa: ' + m3.toFixed(1) + ' / 20';
        document.getElementById('badgeM4').textContent = 'Khoa: ' + m4.toFixed(1) + ' / 25';
        document.getElementById('badgeM5').textContent = 'Khoa: ' + m5.toFixed(1) + ' / 10';

        document.getElementById('lblM1').textContent = m1.toFixed(1);
        document.getElementById('lblM2').textContent = m2.toFixed(1);
        document.getElementById('lblM3').textContent = m3.toFixed(1);
        document.getElementById('lblM4').textContent = m4.toFixed(1);
        document.getElementById('lblM5').textContent = m5.toFixed(1);

        document.getElementById('totalAdminScore').textContent = total.toFixed(1);

        let rank = "Kém";
        let rankClass = "badge bg-secondary";
        if (total >= 90) { rank = "Xuất sắc"; rankClass = "badge bg-success"; }
        else if (total >= 80) { rank = "Tốt"; rankClass = "badge bg-primary"; }
        else if (total >= 65) { rank = "Khá"; rankClass = "badge bg-info text-dark"; }
        else if (total >= 50) { rank = "Trung bình"; rankClass = "badge bg-warning text-dark"; }
        else if (total >= 35) { rank = "Yếu"; rankClass = "badge bg-danger"; }

        const rBadge = document.getElementById('rankBadge');
        rBadge.textContent = rank;
        rBadge.className = rankClass + ' fs-6 px-3 py-2 mb-3';
    }

    function copyDiemSVSangKhoa() {
        document.querySelectorAll('#adminEvalForm tbody tr').forEach(tr => {
            const svCell = tr.querySelector('.sv-val');
            const input = tr.querySelector('.score-input');
            if (svCell && input && !input.disabled) {
                input.value = parseFloat(svCell.textContent.trim().replace(',', '.')) || 0;
            }
        });
        calculateAdminTotal();
    }

    document.querySelectorAll('.score-input').forEach(input => {
        input.addEventListener('input', calculateAdminTotal);
    });

    calculateAdminTotal();

    async function xemFileTrucTiep(phieuId, fileName) {
        document.getElementById('previewFileName').textContent = fileName;
        document.getElementById('btnModalDownload').href = `/Admin/TaiFileMinhChung/${phieuId}`;

        const loadingEl = document.getElementById('docPreviewLoading');
        const errorEl = document.getElementById('docPreviewError');
        const contentEl = document.getElementById('docPreviewContent');

        loadingEl.classList.remove('d-none');
        errorEl.classList.add('d-none');
        contentEl.classList.add('d-none');
        contentEl.innerHTML = '';

        const modal = new bootstrap.Modal(document.getElementById('docPreviewModal'));
        modal.show();

        try {
            const response = await fetch(`/Admin/XemFileMinhChung/${phieuId}`);
            if (!response.ok) {
                const errText = await response.text();
                throw new Error(errText || 'Không thể tải nội dung file từ server.');
            }

            const arrayBuffer = await response.arrayBuffer();
            const result = await mammoth.convertToHtml({ arrayBuffer: arrayBuffer });

            loadingEl.classList.add('d-none');
            contentEl.innerHTML = result.value || '<p class="text-muted text-center">File Word trống không có nội dung văn bản.</p>';
            contentEl.classList.remove('d-none');
        } catch (err) {
            loadingEl.classList.add('d-none');
            errorEl.textContent = '❌ ' + err.message;
            errorEl.classList.remove('d-none');
        }
    }
</script>
}