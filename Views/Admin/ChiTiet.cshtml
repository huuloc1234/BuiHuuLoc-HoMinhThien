                    <div class="row g-2 text-start small border-top border-secondary pt-3">
                        <div class="col-6">Mục I: <strong id="lblM1" class="text-warning">0</strong> / 20</div>
                        <div class="col-6">Mục II: <strong id="lblM2" class="text-warning">0</strong> / 25</div>
                        <div class="col-6">Mục III: <strong id="lblM3" class="text-warning">0</strong> / 20</div>
                        <div class="col-6">Mục IV: <strong id="lblM4" class="text-warning">0</strong> / 25</div>
