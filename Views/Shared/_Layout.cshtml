<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Điểm Rèn Luyện SV</title>

    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
                <i class="bi bi-shield-check fs-4"></i>
                <span>Điểm Rèn Luyện <span class="text-warning">Blockchain</span></span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap me-1"></i>Dashboard Admin
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="SinhVien" asp-action="Dashboard">
                                <i class="bi bi-journal-text me-1"></i>Phiếu Tự Chấm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="SinhVien" asp-action="XemKetQua">
                                <i class="bi bi-award me-1"></i>Kết Quả
                            </a>
                        </li>
                    }
                </ul>

                <div class="navbar-nav ms-auto align-items-center gap-2">
                    <!-- Trạng thái MetaMask -->
                    <span id="walletStatus" class="badge bg-warning text-dark">
                        <i class="bi bi-wallet2 me-1"></i>
                        <span id="walletAddr">Chưa kết nối</span>
                    </span>

                    <span class="navbar-text text-white-50 d-none d-lg-inline">
                        <i class="bi bi-person-circle me-1"></i>
                        @User.FindFirst("mssv")?.Value - @User.Identity?.Name
                    </span>

                    <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                    </a>
                </div>
            </div>
        </div>
    </nav>
}

<!-- ALERTS -->
<div class="container-fluid px-4 mt-3">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
</div>

<!-- MAIN CONTENT -->
<main class="container-fluid px-4 py-3">
    @RenderBody()
</main>

<!-- FOOTER -->
<footer class="bg-dark text-white-50 text-center py-3 mt-5 small">
    <i class="bi bi-shield-check me-1"></i>
    Hệ thống Quản lý Điểm Rèn Luyện | Sepolia Testnet |
    <span class="text-warning">Hybrid Blockchain Architecture</span>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<!-- Ethers.js v5 (CDN với Fallback) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/5.7.2/ethers.umd.min.js"></script>
<script>
    if (typeof ethers === 'undefined') {
        document.write('<script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"><\/script>');
    }
</script>
<!-- Custom JS -->
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
