@model DiemRenLuyen.Models.TaiKhoan
@{
    Layout = null;
    var diaChiVi = ViewBag.DiaChiVi as string ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Ký Tài Khoản Sinh Viên - Điểm Rèn Luyện</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * { font-family: 'Inter', sans-serif; }
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            padding: 20px;
        }
        .register-card {
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2.5rem; width: 100%; max-width: 520px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.5);
            color: #f8fafc;
        }
        .brand-icon {
            width: 56px; height: 56px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.2rem; font-size: 1.5rem; color: white;
        }
        .form-control {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: white; border-radius: 8px; padding: 10px 12px;
        }
        .form-control:focus {
            background: rgba(15, 23, 42, 0.9);
            border-color: #3b82f6; color: white;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
        }
        .form-control::placeholder { color: rgba(255, 255, 255, 0.35); }
        .wallet-box {
            background: rgba(15, 23, 42, 0.4); border: 1px dashed rgba(59, 130, 246, 0.5);
            border-radius: 10px; padding: 10px; font-size: 0.85rem;
        }
        .btn-register {
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            border: none; color: white; font-weight: 600;
            padding: 12px; border-radius: 10px; width: 100%;
            transition: all 0.2s;
        }
        .btn-register:hover { opacity: 0.95; color: white; }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="brand-icon"><i class="bi bi-person-plus-fill"></i></div>
        <h5 class="text-center fw-bold mb-1">Đăng Ký Tài Khoản Sinh Viên</h5>
        <p class="text-center text-muted small mb-4">Hỗ trợ đăng nhập bằng Mật khẩu hoặc Ví MetaMask</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible small">
                @foreach (var modelState in ViewData.ModelState.Values)
                {
                    foreach (var error in modelState.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form method="post" action="/Auth/Register">
            @Html.AntiForgeryToken()

            <!-- THÔNG TIN SINH VIÊN -->
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label small text-muted">Mã Số Sinh Viên (MSSV) *</label>
                    <input type="text" name="mssv" class="form-control" placeholder="VD: SV230005" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted">Lớp Sinh Hoạt *</label>
                    <input type="text" name="lop" class="form-control" placeholder="VD: 23DTH01" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small text-muted">Họ Và Tên Sinh Viên *</label>
                <input type="text" name="hoTen" class="form-control" placeholder="Nhập đầy đủ họ và tên..." required />
            </div>

            <div class="mb-3">
                <label class="form-label small text-muted">Email (dùng để đăng nhập)</label>
                <input type="email" name="email" class="form-control" placeholder="VD: sinhvien@drl.edu.vn" />
            </div>

            <!-- MẬT KHẨU -->
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label small text-muted">Mật khẩu *</label>
                    <input type="password" name="matKhau" class="form-control" placeholder="Tối thiểu 6 ký tự..." required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted">Xác nhận mật khẩu *</label>
                    <input type="password" name="xacNhanMatKhau" class="form-control" placeholder="Nhập lại mật khẩu..." required />
                </div>
            </div>

            <!-- ĐỊA CHỈ VÍ METAMASK (TÙY CHỌN LIÊN KẾT) -->
            <div class="mb-4">
                <label class="form-label small text-muted d-flex justify-content-between align-items-center">
                    <span>Địa chỉ ví MetaMask (Tùy chọn)</span>
                    <button type="button" class="btn btn-sm btn-link text-info p-0 text-decoration-none" onclick="layViHienTai()">
                        <i class="bi bi-wallet2 me-1"></i>Lấy ví từ trình duyệt
                    </button>
                </label>
                <div class="wallet-box">
                    <input type="text" name="diaChiVi" id="txtDiaChiVi" class="form-control font-monospace form-control-sm"
                           value="@diaChiVi" placeholder="0x... (chưa liên kết)" />
                </div>
            </div>

            <button type="submit" class="btn btn-register">
                <i class="bi bi-check-circle me-1"></i>Hoàn Tất Đăng Ký
            </button>
        </form>

        <div class="text-center mt-3 small">
            <span class="text-muted">Đã có tài khoản?</span>
            <a href="/Auth/Login" class="text-info text-decoration-none fw-semibold ms-1">Đăng nhập ngay</a>
        </div>
    </div>

    <script>
    async function layViHienTai() {
        if (typeof window.ethereum === 'undefined') {
            alert('Trình duyệt chưa cài đặt MetaMask!'); return;
        }
        try {
            const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
            if (accounts && accounts.length > 0) {
                document.getElementById('txtDiaChiVi').value = accounts[0];
            }
        } catch (e) {
            console.error(e);
        }
    }
    </script>
</body>
</html>
