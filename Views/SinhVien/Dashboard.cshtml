@model DiemRenLuyen.Models.PhieuDanhGia
@using System.Globalization
@{
    ViewData["Title"] = "Phiếu Đánh Giá Rèn Luyện Sinh Viên";
    var hocKy   = ViewBag.HocKy as string ?? "HK1_2024-2025";
    var daChot  = Model?.DaChot ?? false;
    var m1      = Model?.Muc1 ?? new DiemRenLuyen.Models.ChiTietMuc1();
    var m2      = Model?.Muc2 ?? new DiemRenLuyen.Models.ChiTietMuc2();
    var m3      = Model?.Muc3 ?? new DiemRenLuyen.Models.ChiTietMuc3();
    var m4      = Model?.Muc4 ?? new DiemRenLuyen.Models.ChiTietMuc4();
    var m5      = Model?.Muc5 ?? new DiemRenLuyen.Models.ChiTietMuc5();

    string Fmt(decimal? val) => (val ?? 0m).ToString("0.##", CultureInfo.InvariantCulture);
    string FmtAdmin(decimal? val) => Model?.DiemAdminCham != null ? (val ?? 0m).ToString("0.##", CultureInfo.InvariantCulture) : "-";
}

<style>
    .phieu-card { border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
    .table-eval th { background: #f8fafc; font-size: 0.85rem; font-weight: 600; vertical-align: middle; }
    .table-eval td { vertical-align: middle; font-size: 0.875rem; }
    .header-section { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); color: white; border-radius: 12px; padding: 1.5rem; }
    .score-input { width: 75px; text-align: center; font-weight: 600; border-radius: 6px; border: 1.5px solid #cbd5e1; }
    .score-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.2); }
    .score-input:disabled { background-color: #f1f5f9; cursor: not-allowed; }
    .section-title { background: #f1f5f9; border-left: 4px solid #2563eb; padding: 8px 12px; font-weight: 700; font-size: 0.95rem; margin-bottom: 0; }
    .sticky-summary { position: sticky; top: 80px; }
</style>

<!-- THÔNG TIN SINH VIÊN (LẤY HOÀN TOÀN TỪ TÀI KHOẢN ĐĂNG NHẬP) -->
<div class="header-section mb-4 shadow">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="fw-bold mb-1"><i class="bi bi-file-earmark-text-fill me-2"></i>PHIẾU ĐÁNH GIÁ KẾT QUẢ RÈN LUYỆN CỦA SINH VIÊN</h4>
            <div class="small opacity-90 mt-2">
                <span class="me-3"><strong>Họ và tên:</strong> @(Model?.TaiKhoan?.HoTen)</span>
                <span class="me-3"><strong>MSSV:</strong> @(Model?.MSSV)</span>
                <span class="me-3"><strong>Lớp:</strong> @(Model?.TaiKhoan?.Lop)</span>
                @if (!string.IsNullOrEmpty(Model?.TaiKhoan?.KhoaHoc))
                {
                    <span class="me-3"><strong>Khóa:</strong> @Model.TaiKhoan.KhoaHoc</span>
                }
            </div>
            <div class="small opacity-75 mt-1">
                @if (!string.IsNullOrEmpty(Model?.TaiKhoan?.NgaySinh))
                {
                    <span class="me-3"><strong>Ngày sinh:</strong> @Model.TaiKhoan.NgaySinh</span>
                }
                @if (!string.IsNullOrEmpty(Model?.TaiKhoan?.SoDienThoai))
                {
                    <span class="me-3"><strong>Điện thoại:</strong> @Model.TaiKhoan.SoDienThoai</span>
                }
                <span><strong>Học kỳ:</strong> @hocKy</span>
            </div>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            @if (daChot)
            {
                <span class="badge bg-danger px-3 py-2 fs-6 mb-2 d-inline-block">
                    <i class="bi bi-lock-fill me-1"></i>ĐÃ CHỐT TRÊN BLOCKCHAIN
                </span>
                @if (!string.IsNullOrEmpty(Model?.TxHash))
                {
                    <div>
                        <a href="https://sepolia.etherscan.io/tx/@Model.TxHash" target="_blank" class="badge bg-warning text-dark text-decoration-none">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Xem TxHash
                        </a>
                    </div>
                }
            }
            else if (Model?.DiemAdminCham != null)
            {
                <span class="badge bg-warning text-dark px-3 py-2 fs-6 mb-2 d-inline-block">
                    <i class="bi bi-exclamation-circle-fill me-1"></i>Khoa đã chấm - Chưa chốt
                </span>
                <div class="small text-white-50">Kiểm tra điểm bên phải & gửi phản hồi nếu có sai sót</div>
            }
            else
            {
                <span class="badge bg-success px-3 py-2 fs-6 mb-2 d-inline-block">
                    <i class="bi bi-pencil-fill me-1"></i>Đang trong thời gian tự chấm
                </span>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- CỘT TRÁI: FORM LƯU ĐIỂM TỰ CHẤM (5 MỤC - 61 TIÊU CHÍ) -->
    <div class="col-lg-8">
        <form method="post" action="/SinhVien/LuuDiem" id="evalForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="phieuId" value="@Model?.Id" />

            <!-- MỤC I (Tối đa 20 điểm - 12 tiêu chí) -->
            <div class="card phieu-card mb-4 overflow-hidden">
                <div class="section-title d-flex justify-content-between align-items-center">
                    <span>I. Đánh giá về ý thức tham gia học tập (Điểm tối đa là 20 điểm)</span>
                    <span class="badge bg-primary fs-6" id="badgeM1">@m1.TongMuc1SV / 20</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-bordered table-eval mb-0">
                        <thead>
                            <tr class="text-center">
                                <th style="width: 50px;">#</th>
                                <th>Nội dung đánh giá</th>
                                <th style="width: 100px;">Điểm Tối đa</th>
                                <th style="width: 80px;">Điểm trừ</th>
                                <th style="width: 110px;">Điểm SV tự đánh giá</th>
                                <th style="width: 90px;">Tập thể lớp</th>
                                <th style="width: 90px;">Khoa đánh giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center">1</td>
                                <td>Sinh viên có điểm trung bình học tập tích lũy với thang điểm 4, cụ thể:</td>
                                <td class="text-center text-muted">5 đ/học kỳ</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC1_DiemTBHT" class="form-control score-input score-m1" value="@Fmt(m1.TC1_DiemTBHT)" min="0" max="5" step="0.5" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">@(m1.TongMuc1Lop ?? 0)</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC1_DiemTBHT)</td>
                            </tr>
                            <tr>
                                <td class="text-center">2</td>
                                <td>Có giấy chứng nhận tham gia học các lớp chuyên đề kỹ năng học tập trong và ngoài Trường.</td>
                                <td class="text-center text-muted">3 đ/học kỳ</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC2_ChuyenDeKyNang" class="form-control score-input score-m1" value="@Fmt(m1.TC2_ChuyenDeKyNang)" min="0" max="3" step="0.5" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC2_ChuyenDeKyNang)</td>
                            </tr>
                            <tr>
                                <td class="text-center">3</td>
                                <td>Hội thảo hoặc Tọa đàm do Khoa hoặc Trường tổ chức</td>
                                <td class="text-center text-muted">3 đ/lần</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC3_HoiThaoToaDam" class="form-control score-input score-m1" value="@Fmt(m1.TC3_HoiThaoToaDam)" min="0" max="15" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC3_HoiThaoToaDam)</td>
                            </tr>
                            <tr>
                                <td class="text-center">4</td>
                                <td>Các cuộc thi học thuật cấp Khoa hoặc Trường tổ chức trực tiếp hoặc trực tuyến</td>
                                <td class="text-center text-muted">7 đ/lần</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC4_ThiHocThuatTruong" class="form-control score-input score-m1" value="@Fmt(m1.TC4_ThiHocThuatTruong)" min="0" max="14" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC4_ThiHocThuatTruong)</td>
                            </tr>
                            <tr>
                                <td class="text-center">5</td>
                                <td>Các cuộc thi học thuật do các đơn vị bên ngoài trường tổ chức</td>
                                <td class="text-center text-muted">8 đ/lần</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC5_ThiHocThuatNgoai" class="form-control score-input score-m1" value="@Fmt(m1.TC5_ThiHocThuatNgoai)" min="0" max="16" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC5_ThiHocThuatNgoai)</td>
                            </tr>
                            <tr>
                                <td class="text-center">6</td>
                                <td>Báo cáo khoa học cấp Khoa</td>
                                <td class="text-center text-muted">8 đ/lần</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC6_BaoCaoKhoaHocKhoa" class="form-control score-input score-m1" value="@Fmt(m1.TC6_BaoCaoKhoaHocKhoa)" min="0" max="16" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC6_BaoCaoKhoaHocKhoa)</td>
                            </tr>
                            <tr>
                                <td class="text-center">7</td>
                                <td>Tham gia đề tài NCKH Trường (không tính bài tập, tiểu luận, đồ án môn học, luận văn …)</td>
                                <td class="text-center text-muted">10 đ/lần</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC7_DeTaiNCKHTruong" class="form-control score-input score-m1" value="@Fmt(m1.TC7_DeTaiNCKHTruong)" min="0" max="20" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC7_DeTaiNCKHTruong)</td>
                            </tr>
                            <tr>
                                <td class="text-center">8</td>
                                <td>Viết bài báo khoa học trong và ngoài Trường</td>
                                <td class="text-center text-muted">8 đ/lần</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC8_BaiBaoKhoaHoc" class="form-control score-input score-m1" value="@Fmt(m1.TC8_BaiBaoKhoaHoc)" min="0" max="16" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC8_BaiBaoKhoaHoc)</td>
                            </tr>
                            <tr>
                                <td class="text-center">9</td>
                                <td>Các cuộc thi khởi nghiệp do Trường tổ chức</td>
                                <td class="text-center text-muted">7 đ/lần</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC9_KhoiNghiepTruong" class="form-control score-input score-m1" value="@Fmt(m1.TC9_KhoiNghiepTruong)" min="0" max="14" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC9_KhoiNghiepTruong)</td>
                            </tr>
                            <tr>
                                <td class="text-center">10</td>
                                <td>Các cuộc thi khởi nghiệp do đơn vị ngoài Trường tổ chức</td>
                                <td class="text-center text-muted">8 đ/lần</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC10_KhoiNghiepNgoai" class="form-control score-input score-m1" value="@Fmt(m1.TC10_KhoiNghiepNgoai)" min="0" max="16" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC10_KhoiNghiepNgoai)</td>
                            </tr>
                            <tr>
                                <td class="text-center">11</td>
                                <td>Thành viên các câu lạc bộ học thuật cấp Khoa, Trường</td>
                                <td class="text-center text-muted">2 đ/học kỳ</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC11_ThanhVienCLB" class="form-control score-input score-m1" value="@Fmt(m1.TC11_ThanhVienCLB)" min="0" max="2" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC11_ThanhVienCLB)</td>
                            </tr>
                            <tr>
                                <td class="text-center">12</td>
                                <td>Các hoạt động khác</td>
                                <td class="text-center text-muted">3 đ/lần</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc1.TC12_HoatDongKhac" class="form-control score-input score-m1" value="@Fmt(m1.TC12_HoatDongKhac)" min="0" max="15" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m1.Admin_TC12_HoatDongKhac)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MỤC II (Tối đa 25 điểm - 8 tiêu chí) -->
            <div class="card phieu-card mb-4 overflow-hidden">
                <div class="section-title d-flex justify-content-between align-items-center">
                    <div>
                        <span>II. Đánh giá về ý thức chấp hành nội quy, quy chế và các quy định của Nhà trường (Điểm tối đa là 25 điểm)</span>
                        <div class="small fw-normal text-muted fst-italic">Lưu ý: Tối đa từng tiêu chí là 5 điểm và tối thiểu là 0 điểm (không có điểm âm).</div>
                    </div>
                    <span class="badge bg-warning text-dark fs-6" id="badgeM2">@m2.TongMuc2SV / 25</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-bordered table-eval mb-0">
                        <thead>
                            <tr class="text-center">
                                <th style="width: 50px;">#</th>
                                <th>Nội dung đánh giá</th>
                                <th style="width: 100px;">Điểm Tối đa</th>
                                <th style="width: 80px;">Điểm trừ</th>
                                <th style="width: 110px;">Điểm SV tự đánh giá</th>
                                <th style="width: 90px;">Tập thể lớp</th>
                                <th style="width: 90px;">Khoa đánh giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center">1</td>
                                <td>Sinh viên có ý thức, thái độ trong học tập.</td>
                                <td class="text-center text-muted">5 đ/học kỳ</td>
                                <td class="text-center">-</td>
                                <td class="text-center"><input type="number" name="muc2.TC1_ThaiDoHocTap" class="form-control score-input score-m2" value="@Fmt(m2.TC1_ThaiDoHocTap)" min="0" max="5" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m2.Admin_TC1_ThaiDoHocTap)</td>
                            </tr>
                            <tr>
                                <td class="text-center">2</td>
                                <td>Sinh viên có ý thức chấp hành tốt, đầy đủ các nội quy, quy chế và các quy định của Nhà trường</td>
                                <td class="text-center text-muted">5 đ/học kỳ</td>
                                <td class="text-center text-danger">-5 đ</td>
                                <td class="text-center"><input type="number" name="muc2.TC2_ChapHanhNoiQuy" class="form-control score-input score-m2" value="@Fmt(m2.TC2_ChapHanhNoiQuy)" min="0" max="5" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m2.Admin_TC2_ChapHanhNoiQuy)</td>
                            </tr>
                            <tr>
                                <td class="text-center">3</td>
                                <td>Sinh viên thực hiện tốt quy chế khi tham gia các kỳ thi, cuộc thi</td>
                                <td class="text-center text-muted">5 đ/học kỳ</td>
                                <td class="text-center text-danger">-5 đ</td>
                                <td class="text-center"><input type="number" name="muc2.TC3_QuyCheThi" class="form-control score-input score-m2" value="@Fmt(m2.TC3_QuyCheThi)" min="0" max="5" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m2.Admin_TC3_QuyCheThi)</td>
                            </tr>
                            <tr>
                                <td class="text-center">4</td>
                                <td>Chấp hành quy định của thư viện</td>
                                <td class="text-center text-muted">5 đ/học kỳ</td>
                                <td class="text-center text-danger">-5 đ</td>
                                <td class="text-center"><input type="number" name="muc2.TC4_QuyDinhThuVien" class="form-control score-input score-m2" value="@Fmt(m2.TC4_QuyDinhThuVien)" min="0" max="5" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m2.Admin_TC4_QuyDinhThuVien)</td>
                            </tr>
                            <tr>
                                <td class="text-center">5</td>
                                <td>Chấp hành quy định của phòng học, phòng máy, phòng thực hành</td>
                                <td class="text-center text-muted">5 đ/học kỳ</td>
                                <td class="text-center text-danger">-5 đ</td>
                                <td class="text-center"><input type="number" name="muc2.TC5_QuyDinhPhongHocMay" class="form-control score-input score-m2" value="@Fmt(m2.TC5_QuyDinhPhongHocMay)" min="0" max="5" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m2.Admin_TC5_QuyDinhPhongHocMay)</td>
                            </tr>
                            <tr>
                                <td class="text-center">6</td>
                                <td>Thực hiện đăng ký ngoại trú</td>
                                <td class="text-center text-muted">5 đ/học kỳ</td>
                                <td class="text-center text-danger">-5 đ</td>
                                <td class="text-center"><input type="number" name="muc2.TC6_DangKyNgoaiTru" class="form-control score-input score-m2" value="@Fmt(m2.TC6_DangKyNgoaiTru)" min="0" max="5" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m2.Admin_TC6_DangKyNgoaiTru)</td>
                            </tr>
                            <tr>
                                <td class="text-center">7</td>
                                <td>Mặc đồng phục đúng quy định</td>
                                <td class="text-center text-muted">5 đ/học kỳ</td>
                                <td class="text-center text-danger">-5 đ</td>
                                <td class="text-center"><input type="number" name="muc2.TC7_MacDongPhuc" class="form-control score-input score-m2" value="@Fmt(m2.TC7_MacDongPhuc)" min="0" max="5" step="1" @(daChot?"disabled":"") /></td>
                                <td class="text-center text-muted small">-</td>
                                <td class="text-center fw-bold text-primary">@FmtAdmin(m2.Admin_TC7_MacDongPhuc)</td>
                            </tr>
                            <tr>
                                <td class="text-center">8</td>
